# ==============================================================================
# CORDANO PMS — Variables de Entorno y Configuración de Proyecto
# ==============================================================================
# Copie este archivo como '.env' para sobreescribir la configuración por defecto
# al traspasar el proyecto a una nueva cuenta de Google Cloud o dominio de cliente.
# ==============================================================================

# ── 1. Entorno de Ejecución Local ──
PORT=3000
NODE_ENV=development

# ── 2. Firebase & Google Cloud Firestore ──
# (Por defecto se resuelven automáticamente desde 'firebase-applet-config.json')
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0862587160
VITE_FIREBASE_APP_ID=1:349577440002:web:488eeb4a99c415e104f01b
VITE_FIREBASE_API_KEY=AIzaSyAL5dqHzF0ymkxhE8SYvA1ldUYPdMZw_GE
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0862587160.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0862587160.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=349577440002
VITE_FIREBASE_MEASUREMENT_ID=

# ── 3. Google OAuth & Google Sheets API ──
# Client ID de Google Identity Services para sincronización con Google Drive / Sheets
VITE_GOOGLE_CLIENT_ID=349577440002-6r0ijjtbqo7biqt4c8cd9r69daeit48v.apps.googleusercontent.com

# ── 4. Asistente Operativo / Gemini API (Opcional) ──
