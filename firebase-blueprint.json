{
  "entities": {
    "Ticket": {
      "title": "Ticket",
      "description": "Registro transaccional de estadía conforme a Ley N° 20.967 (gracia de 15 min, sin multas punitivas)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketCode": { "type": "string" },
        "plateNumber": { "type": "string" },
        "vehicleType": { "type": "string", "enum": ["Automóvil", "Camioneta", "Motocicleta", "Furgón / SUV"] },
        "slotCode": { "type": "string" },
        "entryTime": { "type": "string" },
        "exitTime": { "type": "string" },
        "status": { "type": "string", "enum": ["activo", "pagado", "anulado"] },
        "durationMinutes": { "type": "number" },
        "subtotalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "discountReason": { "type": "string" },
        "isLostTicket": { "type": "boolean" },
        "isLostTicketResolvedByPlate": { "type": "boolean" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "changeAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["efectivo", "tarjeta_debito", "tarjeta_credito", "transferencia", "convenio"] },
        "tariffVersionId": { "type": "string" },
        "operatorEntryName": { "type": "string" },
        "operatorExitName": { "type": "string" },
        "voucherNumber": { "type": "string" },
        "dteFolio": { "type": "string" },
        "dteType": { "type": "number", "enum": [39, 41] },
        "tedXml": { "type": "string" }
      },
      "required": ["id", "ticketCode", "plateNumber", "vehicleType", "slotCode", "entryTime", "status", "operatorEntryName"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Control de turno operativo de garita: fondo inicial de $ 50.000 CLP, arqueo ciego en 3 pasos y sello SHA-256",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "operatorId": { "type": "string" },
        "operatorName": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string", "enum": ["abierto", "cerrado"] },
        "initialCash": { "type": "number", "default": 50000 },
        "initialCashBreakdown": { "type": "object" },
        "declaredCash": { "type": "number" },
        "declaredCard": { "type": "number" },
        "declaredTransfer": { "type": "number" },
        "declaredCashBreakdown": { "type": "object" },
        "handoverFundAmount": { "type": "number" },
        "expectedCash": { "type": "number" },
        "expectedCard": { "type": "number" },
        "expectedTransfer": { "type": "number" },
        "expectedTotal": { "type": "number" },
        "totalDifference": { "type": "number" },
        "discrepancyCash": { "type": "number" },
        "isDiscrepancyFlagged": { "type": "boolean" },
        "closeJustification": { "type": "string" },
        "hash": { "type": "string" },
        "hashAuditoria": { "type": "string" },
        "authorizedBySupervisorPin": { "type": "string" },
        "supervisorName": { "type": "string" },
        "pendingApprovals": { "type": "array" },
        "signedCopy1Caja": { "type": "boolean" },
        "signedCopy2Operador": { "type": "boolean" },
        "checklistCompleted": { "type": "boolean" }
      },
      "required": ["id", "operatorId", "operatorName", "startTime", "initialCash", "status"]
    },
    "ParkingSlot": {
      "title": "ParkingSlot",
      "description": "Distribución física de las 30 plazas exactas de Serrano 447 (Sector A: 01-15 techado, Sector B: 16-30 general)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "zone": { "type": "string", "enum": ["Zona A (Techado)", "Zona B (General)", "Zona C (Preferencial)"] },
        "status": { "type": "string", "enum": ["disponible", "ocupado", "reservado", "mantenimiento"] },
        "currentTicketId": { "type": "string" },
        "occupiedSince": { "type": "string" },
        "plateNumber": { "type": "string" }
      },
      "required": ["id", "code", "zone", "status"]
    },
    "Agreement": {
      "title": "Agreement",
      "description": "Convenios corporativos y abonados mensuales en recinto Serrano 447",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plateNumber": { "type": "string" },
        "plates": { "type": "array", "items": { "type": "string" } },
        "companyName": { "type": "string" },
        "contactName": { "type": "string" },
        "rutCompany": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "agreementType": { "type": "string", "enum": ["Convenio Mensual", "Convenio Comercial", "Convenio Empresa", "Servicio Nocturno"] },
        "monthlyFeeClp": { "type": "number" },
        "validUntil": { "type": "string" },
        "status": { "type": "string", "enum": ["al_dia", "por_vencer", "vencido"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "plateNumber", "companyName", "agreementType", "monthlyFeeClp", "validUntil", "status"]
    },
    "CashMovement": {
      "title": "CashMovement",
      "description": "Movimientos de efectivo en turno: sangrías, retiros justificados o ingresos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shiftId": { "type": "string" },
        "type": { "type": "string", "enum": ["RETIRO_SANGRIA", "GASTO_MENOR", "INGRESO_MANUAL"] },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "operatorId": { "type": "string" },
        "operatorName": { "type": "string" },
        "timestamp": { "type": "string" },
        "voucherFolio": { "type": "string" },
        "authorizedBySupervisor": { "type": "string" }
      },
      "required": ["id", "shiftId", "type", "amount", "reason", "operatorId", "timestamp"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro append-only inmutable de incidencias operativas y aprobaciones express diferidas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "authorizedBy": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "userName", "action", "details", "severity"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Colección de tickets de estacionamiento regulados por Ley 20.967"
    },
    "/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Colección de turnos y arqueos ciegos con sello SHA-256"
    },
    "/slots/{slotId}": {
      "schema": "ParkingSlot",
      "description": "Colección de las 30 plazas físicas de Serrano 447"
    },
    "/agreements/{agreementId}": {
      "schema": "Agreement",
      "description": "Colección de convenios y abonados mensuales"
    },
    "/cash_movements/{movementId}": {
      "schema": "CashMovement",
      "description": "Colección de sangrías y gastos operativos de caja"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Bitácora inalterable append-only con validación de supervisor"
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "Parámetros del recinto, tarifas y tolerancias normativas"
    },
    "/customers/{customerId}": {
      "schema": "object",
      "description": "Directorio de clientes frecuentes y convenios asociados"
    }
  }
}
